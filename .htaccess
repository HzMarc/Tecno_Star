Options -Indexes

RewriteEngine On

# El único punto de entrada público de la aplicación es /public/.
RewriteRule ^$ %{REQUEST_URI}public/ [R=302,L]

# Bloquea el acceso web a código, configuración, rutas y archivos internos.
RewriteRule ^(?:app|config|core|routes|storage|graphify-out|database|tests|vendor|docs)(?:/|$) - [F,L,NC]
RewriteRule ^composer\.(?:json|lock)$ - [F,L,NC]

# Bloquea archivos ocultos y archivos que nunca deben servirse al navegador.
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(?:env|ini|log|sql|bak|backup)$ - [F,L,NC]
