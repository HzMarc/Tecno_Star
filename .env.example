# Copia este archivo a .env. No incluyas credenciales reales en este ejemplo.
# Las variables del proceso/servidor tienen prioridad sobre .env.
APP_NAME="Tecno Star"
# Puede ser una ruta (/tienda/public), una URL completa o / para la raiz.
APP_URL=/Tecno_Star/public
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=tecno_star
DB_USER=root
DB_PASSWORD=""

# Limites compartidos por procesos, en almacenamiento local del servidor.
LOGIN_PAIR_LIMIT=5
LOGIN_IP_LIMIT=30
LOGIN_WINDOW_SECONDS=900

# Segundos. La cookie es de navegador por defecto; 1 permite persistencia.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
SESSION_REGENERATE_SECONDS=900
SESSION_PERSISTENT=0
LOG_RETENTION_DAYS=14
# APP_STORAGE_PATH es opcional y debe ser una ruta absoluta.

# Pedidos, QR y correo. URL completa: usa IP de la PC para lectores en la misma red.
ORDER_PUBLIC_URL=http://localhost:8012/Tecno_Star/public
# IDs separados por comas. Solo aplica a usuarios activos con rol Empleado.
ORDER_STAFF_USER_IDS=""
MAIL_ENABLED=0
MAIL_USERNAME=henriquezquinterosmarcosjusue@gmail.com
# Contraseña de aplicación de Google, NO la contraseña normal de Gmail.
MAIL_PASSWORD=""
MAIL_FROM_NAME="Tecno Star"

# Inicio de sesión con Google OAuth; consulta docs/GUIA_GMAIL_GOOGLE.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=http://localhost:8012/Tecno_Star/public/auth/google/callback
